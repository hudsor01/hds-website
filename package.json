{
	"$schema": "https://json.schemastore.org/package",
	"name": "hds-website",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "command bun run scripts/blog/build.ts && next dev",
		"dev:https": "command bun run scripts/blog/build.ts && cross-env HTTPS=true next dev",
		"build": "command bun run scripts/blog/build.ts && next build --webpack",
		"start": "next start",
		"lint": "biome check src/ scripts/gsc tests/unit/gsc-*.ts",
		"lint:fix": "biome check src/ scripts/gsc tests/unit/gsc-*.ts --write",
		"format": "biome format --write src/ scripts/gsc tests/unit/gsc-*.ts",
		"typecheck": "command bun run scripts/blog/build.ts && tsc --noEmit",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:fast": "playwright test --project=chromium --workers=1",
		"test:e2e:ci": "playwright test --project=chromium --workers=1 --grep-invert=@visual",
		"test:e2e:visual": "cross-env BLOG_CONTENT_DIR=tests/fixtures/blog playwright test --project=chromium --workers=1 --grep=@visual",
		"test:e2e:a11y": "playwright test --grep '@accessibility'",
		"test:e2e:animations": "playwright test --project=animations",
		"test:e2e:animations:quick": "playwright test animations-quick.spec.ts --grep '@critical'",
		"test:e2e:report": "playwright show-report",
		"test:e2e:install": "playwright install",
		"test:unit": "bash scripts/check-test-mock-leaks.sh && command bun run scripts/blog/build.ts && command bun test tests/",
		"test:unit:random": "bash scripts/check-test-mock-leaks.sh && command bun run scripts/blog/build.ts && bash scripts/test-unit-random.sh",
		"test:unit:watch": "command bun run scripts/blog/build.ts && bun test --watch tests/",
		"test:unit:coverage": "command bun run scripts/blog/build.ts && bun test --coverage tests/",
		"test:all": "command bun run lint && command bun run typecheck && command bun run test:unit && command bun run test:e2e:fast",
		"test:ci": "command bun run lint && command bun run typecheck && command bun run test:unit && command bun run test:e2e",
		"clean": "rm -rf .next out playwright-report test-results",
		"clean:test": "rm -rf playwright-report test-results",
		"test:install": "npm run test:e2e:install",
		"test:update-snapshots": "playwright test --update-snapshots",
		"db:push": "drizzle-kit push",
		"brand:generate": "bun run scripts/generate-brand-tokens.ts",
		"blog:build": "bun run scripts/blog/build.ts",
		"blog:validate": "bun run scripts/blog/validate.ts",
		"blog:coverage": "bun run scripts/blog/tool-coverage.ts",
		"blog:links": "bun run scripts/blog/links.ts",
		"blog:generate": "bun run scripts/blog/generate.ts",
		"prepare": "lefthook install && bun run brand:generate"
	},
	"dependencies": {
		"@neondatabase/serverless": "1.2.1",
		"@radix-ui/react-accordion": "1.3.1",
		"@radix-ui/react-checkbox": "1.4.1",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-select": "2.4.1",
		"@radix-ui/react-slot": "1.5.0",
		"@react-pdf/renderer": "4.9.0",
		"@sentry/nextjs": "11.16.0",
		"@t3-oss/env-nextjs": "0.13.11",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.108.2",
		"@upstash/redis": "1.41.0",
		"@vercel/analytics": "2.0.1",
		"@vercel/blob": "2.9.0",
		"@vercel/speed-insights": "2.1.0",
		"better-auth": "1.7.27",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"drizzle-orm": "0.45.4",
		"lucide-react": "1.77.0",
		"nuqs": "2.10.3",
		"react-email": "6.11.16",
		"react-error-boundary": "6.1.6",
		"react-markdown": "10.1.0",
		"recharts": "3.11.0",
		"resend": "6.39.0",
		"sanitize-html": "2.18.2",
		"server-only": "0.0.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.1",
		"zod": "4.6.7",
		"zustand": "5.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@happy-dom/global-registrator": "21.0.4",
		"@playwright/test": "1.65.1",
		"@sentry/bun": "11.16.0",
		"@tailwindcss/postcss": "4.3.5",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "8.0.0",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.13",
		"@types/bun": "1.4.5",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/sanitize-html": "2.16.2",
		"cross-env": "10.1.0",
		"drizzle-kit": "0.31.11",
		"gray-matter": "4.0.3",
		"lefthook": "2.2.2",
		"marked": "18.2.1",
		"next": "16.4.6",
		"playwright": "1.65.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2",
		"typescript6": "npm:typescript@6.0.3"
	},
	"overrides": {
		"path-to-regexp": "8.4.2",
		"esbuild": "0.28.2",
		"fast-uri": "3.1.9",
		"postcss": "8.5.32",
		"brace-expansion": "5.0.12",
		"ws": "8.22.1",
		"zod": "4.6.7",
		"undici": "6.29.1",
		"js-yaml": "3.15.2",
		"socket.io-parser": "4.2.7",
		"engine.io": "6.6.12",
		"source-map-js": "1.2.4",
		"fflate": "0.8.3",
		"baseline-browser-mapping": "2.11.39"
	},
	"packageManager": "bun@1.3.14"
}
